# SupplyChain IQ - Environment Configuration Example

# Application Settings
APP_NAME="SupplyChain IQ"
APP_ENV=development
APP_DEBUG=true

# Database (PostgreSQL 17)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supplychain_iq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://postgres:postgres@localhost:5432/supplychain_iq

# Authentication & Security
SECRET_KEY=supplychain-iq-super-secret-jwt-key-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis Cache & Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Planning & Simulation Defaults
DEFAULT_HORIZON_WEEKS=26
SYNTHETIC_DATA_RANDOM_SEED=20261022

# Frontend Client
VITE_API_BASE_URL=http://127.0.0.1:8000

